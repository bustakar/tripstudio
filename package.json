{
  "name": "tripstudio",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build && pnpm check:server-output",
    "preview": "vite preview",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:server-output": "for output_dir in .output/server .vercel/output/functions; do if test -d \"$output_dir\"; then find \"$output_dir\" -type f -name '*.mjs' -exec node --check {} \\;; fi; done",
    "db:generate": "drizzle-kit generate && auth generate --config src/lib/auth.ts --output drizzle/auth.sql --yes",
    "db:migrate": "drizzle-kit migrate && auth migrate --config src/lib/auth.ts --yes",
    "check": "pnpm generate-routes && prettier --check . && eslint . && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@better-auth/cimd": "^1.7.0",
    "@better-auth/mcp": "^1.7.0",
    "@better-auth/oauth-provider": "^1.7.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@t3-oss/env-core": "^0.13.11",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-router": "^1.170.30",
    "@tanstack/react-start": "^1.168.47",
    "better-auth": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.31.0",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tanstack/eslint-config": "^0.4.0",
    "@tanstack/router-cli": "^1.167.31",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "auth": "^1.7.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.20.0",
    "jsdom": "^30.0.1",
    "nitro": "3.0.260610-beta",
    "prettier": "^3.8.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.2",
    "vercel": "59.1.4",
    "vite": "8.1.5",
    "vitest": "^4.1.10"
  }
}
